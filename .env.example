# ReversingLabs CLI Environment Variables Example
# Copy this file to .env and fill in your actual values.
# Prefixes map to the settings models: TICLOUD_, A1000_, OUTPUT_, RL_CLI_.

# TitaniumCloud API (username/password authentication)
TICLOUD_USERNAME=your_ticloud_username
TICLOUD_PASSWORD=your_ticloud_password
# TICLOUD_HOST=https://data.reversinglabs.com
# Certificate verification, and the sharing switch below, take only the words
# `true` and `false`. `0`, `no`, `off` and an empty value are refused rather
# than read as "stop verifying" — turning it off is said, not inferred.
# TICLOUD_VERIFY_SSL=true
# TICLOUD_PROXY=http://proxy.example.com:8080
# TICLOUD_TIMEOUT=300
# TICLOUD_USER_AGENT=RL-CLI/0.1.0
# Share looked-up URLs, and their results, with third-party feeds.
# Off by default: the URLs this tool asks about are the analyst's
# investigation targets, and the endpoint publishes them when told to.
# TICLOUD_SHARE_URL_LOOKUPS=false

# A1000 / Spectra Analyze appliance
A1000_HOST=https://your-a1000-instance.local
A1000_TOKEN=your_a1000_api_token_here
# OR username/password authentication
# A1000_USERNAME=your_username
# A1000_PASSWORD=your_password
# `false` here is how an on-prem appliance with a self-signed certificate is
# reached; only that word does it.
# A1000_VERIFY_SSL=true
# A1000_PROXY=http://proxy.example.com:8080
# A1000_TIMEOUT=300

# The YARA Online Source repository token is deliberately NOT here.
# `a1000 yara-repo-create` and `a1000 yara-repo-update` send a credential for
# somebody else's system (a GitHub PAT, typically), and this file is plaintext
# in the working directory that nothing in this CLI creates 0600 or keeps out of
# a commit — the wrong home for a live third-party token. Pass it with
# `--api-token-stdin`, which pipes it in or prompts for it without echoing, and
# so keeps it out of both `ps` and your shell history:
#
#   rl-cli a1000 yara-repo-create --url <repo> --name <name> --api-token-stdin
#   pass show github/rules-pat | rl-cli a1000 yara-repo-create ... --api-token-stdin
#
# `--api-token <token>` still works and is what a public repository states as
# `--api-token ''`, but as an argument it is visible in `ps` to every user on
# the machine for the life of the process.

# Output defaults
# OUTPUT_FORMAT=rich  # rich, json, yaml, table, raw, toon, sarif
# OUTPUT_COLOR=true
# OUTPUT_VERBOSE=false
# OUTPUT_QUIET=false

# Global settings
# RL_CLI_PROFILE=default
# RL_CLI_CACHE_DIR=~/.cache/rl-cli
# RL_CLI_CONFIG_DIR=~/.config/rl-cli
# Same as --config: the file to read instead of searching the standard locations.
# RL_CLI_CONFIG_FILE=~/.rl-cli.yaml
